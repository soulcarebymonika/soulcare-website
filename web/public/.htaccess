<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS & WWW in a single direct 301 redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.soulcarebymonika.com/$1 [R=301,L]

  # 2. Strip trailing slashes (except root and existing directories)
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://www.soulcarebymonika.com/$1 [R=301,L]

  # 3. Legacy /services → /sessions redirects
  RewriteRule ^services/(.*)$ https://www.soulcarebymonika.com/sessions/$1 [R=301,L]
  RewriteRule ^services/?$ https://www.soulcarebymonika.com/sessions [R=301,L]
</IfModule>
